# ── Banco de dados (Postgres já instanciado — local e VPS; nada sobe por compose) ──
# O schema `nayztech` e as migrations são aplicados automaticamente no start.
DATABASE_URL=postgres://nayz:nayzpassword@localhost:5432/nexus?sslmode=disable

# ── Servidor ──
PORT=8082

# ── Auth (nayz-auth) ──
# JWT_SECRET deve ser IDÊNTICA à do nayz-auth (validação HS256 local, modelo tallo-planning-api)
JWT_SECRET=Pw/x+S9ulWyvt5hgb6urXclGCwHujOtt0Ul2ydIUtfZabziR+5zepXzsJhp0oC09
# app_id (uuid) da aplicação NAYZTECH registrada no nayz-auth — tokens de outras apps são recusados
NAYZ_AUTH_APP_ID=c840b3ab-024e-4770-947c-837d64df7406

# ── CORS: origens permitidas, separadas por vírgula ("*" apenas em dev) ──
CORS_ORIGINS=http://localhost:5173,https://nexus.host.com.br

# ── Rate limit das rotas públicas (por IP) ──
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20

# ── MinIO (instância já existente — local e VPS; bucket é criado se não existir) ──
# ATENÇÃO: endpoint é a API S3, apenas host[:porta] — SEM http:// e SEM caminho.
# (a API S3 costuma ficar na porta 9000; o console web em 9001 NÃO serve aqui)
MINIO_ENDPOINT=minio.host.com.br
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=123
# apenas o nome do bucket, sem "/" — o prefixo articles/AAAA/MM/ já é gerado nas chaves
MINIO_BUCKET=bucket
# true quando a API S3 estiver atrás de TLS (https)
MINIO_USE_SSL=false
# URL pública que serve a raiz do bucket (na VPS: rota do proxy reverso; local: o próprio MinIO)
MINIO_PUBLIC_URL=http://minio.host.com/nexus
# validade da URL presigned de upload (spec §9: expiração curta)
PRESIGN_EXPIRY_MINUTES=10
# aplica leitura anônima (só GET) no prefixo articles/* a cada start (default true)
# ATENÇÃO: substitui a política do bucket por essa regra
MINIO_PUBLIC_READ=true
